{
  "ci": {
    "collect": {
      "startServerCommand": "npx --yes serve@14 --no-clipboard -l 8080 .",
      "startServerReadyPattern": "Accepting connections",
      "url": [
        "http://localhost:8080/",
        "http://localhost:8080/buerocontainer",
        "http://localhost:8080/lager-und-seecontainer",
        "http://localhost:8080/sanitaercontainer",
        "http://localhost:8080/containeranlagen",
        "http://localhost:8080/kontakt",
        "http://localhost:8080/impressum",
        "http://localhost:8080/datenschutz"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 200
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 102400
          }
        ],
        "resource-summary:total:size": [
          "error",
          {
            "maxNumericValue": 1048576
          }
        ],
        "canonical": "off"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci-reports"
    }
  }
}
