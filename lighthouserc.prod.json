{
  "ci": {
    "collect": {
      "url": [
        "https://www.raumrent.de/",
        "https://www.raumrent.de/buerocontainer",
        "https://www.raumrent.de/lager-und-seecontainer",
        "https://www.raumrent.de/sanitaercontainer",
        "https://www.raumrent.de/containeranlagen",
        "https://www.raumrent.de/kontakt",
        "https://www.raumrent.de/impressum",
        "https://www.raumrent.de/datenschutz"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 200
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 102400
          }
        ],
        "resource-summary:total:size": [
          "error",
          {
            "maxNumericValue": 1048576
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci-reports"
    }
  }
}
