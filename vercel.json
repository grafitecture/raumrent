{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/gone.js": { "includeFiles": "404.html" }
  },
  "redirects": [
    {"source": "/wp-content/uploads/2025/05/RAUMRENT_AMB.pdf", "destination": "https://www.raumrent.de/downloads/RAUMRENT_AMB.pdf", "permanent": true},
    {"source": "/wp-content/uploads/2025/05/RAUMRENT_AVLB.pdf", "destination": "https://www.raumrent.de/downloads/RAUMRENT_AVLB.pdf", "permanent": true},
    {"source": "/(wp-sitemap.*\\.xml)", "destination": "https://www.raumrent.de/sitemap.xml", "permanent": true},
    {"source": "/index.php", "destination": "https://www.raumrent.de/", "permanent": true},
    {"source": "/:path((?!(?:author|sample-page|feed|comments|wp-admin|wp-includes|wp-json|wp-content|api)(?:/|$)).+)/", "destination": "https://www.raumrent.de/:path", "permanent": true},
    {"source": "/:path*", "has": [{"type": "host", "value": "^raumrent\\.de$"}], "destination": "https://www.raumrent.de/:path*", "permanent": true},
    {"source": "/:path*", "has": [{"type": "host", "value": "^(?:raumrent|raumrent-git-main)-grafitecture\\.vercel\\.app$"}], "destination": "https://www.raumrent.de/:path*", "permanent": true}
  ],
  "rewrites": [
    {"source": "/(author|sample-page|feed|comments|wp-admin|wp-includes|wp-json|wp-content)(/.*)?", "destination": "/api/gone"},
    {"source": "/(wp-login\\.php|xmlrpc\\.php|wp-cron\\.php|wp-signup\\.php|wp-trackback\\.php)", "destination": "/api/gone"}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "X-Frame-Options", "value": "SAMEORIGIN"},
        {"key": "Cross-Origin-Opener-Policy", "value": "same-origin"},
        {"key": "Permissions-Policy", "value": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"},
        {"key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains"},
        {"key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'self'; form-action 'self' mailto:; base-uri 'self'; frame-ancestors 'self'; object-src 'none'; require-trusted-types-for 'script'"}
      ]
    },
    {"source": "/(llms\\.txt|404|api/.*)", "headers": [{"key": "X-Robots-Tag", "value": "noindex"}]},
    {"source": "/assets/img/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/assets/fonts/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/assets/(css|js)/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=3600, must-revalidate"}]},
    {"source": "/downloads/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=86400"}]}
  ]
}
